# Copy to .env (gitignored) and point at your own files.
# All optional: every command still accepts an explicit path / --criteria.

# Default library for every command — a .rmbackup, or the live Rig Manager directory
# (`history` reads that directory's Backups/ folder).
KEMPERRIG_LIBRARY="$HOME/Library/Application Support/Kemper Amps/RigManager"

# Default criteria file for `shortlist`. Start from config/example-shortlist.json.
KEMPERRIG_CRITERIA="./config/example-shortlist.json"

# A census written by `kemperrig summary --write-golden`. With KEMPERRIG_LIBRARY set too,
# tests/test_golden.py checks that library still matches it; without both, it skips.
# KEMPERRIG_GOLDEN="/path/to/your/golden.json"

# If you keep rigs pulled off the Profiler in their own library folder, name it here and
# `analyze` will exempt it from the orphan sweep. There is no default — the name is your
# filing convention, not something Rig Manager defines.
# KEMPERRIG_RACK_FOLDER="Rack"

# Where effect type names come from. Defaults to the Stomps.xml inside a standard Rig
# Manager install; set this only if yours lives elsewhere.
# KEMPERRIG_STOMPS_XML="/Applications/Rig Manager.app/Contents/Resources/Stomps.xml"
