.ai/plans/*
!.ai/plans/.gitkeep
.ai/scripts/
.ai/docs/
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.superpowers/
.cbmignore
CLAUDE.local.md

